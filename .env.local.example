# Copy this file to .env.local and fill it in. .env.local is gitignored.

# Where the hourly spreadsheets are written. The server refreshes them on the
# hour, every hour, while it is running. Leave blank to turn the export off.
FLAPPY_EXPORT_DIR=

# Optional: also push each registration to a Google Sheet as it happens.
# See the header of tools/google-apps-script.js for setup. The URL is
# effectively a password - anyone holding it can append rows.
# FLAPPY_SHEET_URL=
# FLAPPY_SHEET_TOKEN=

# Optional: refuse character-artwork uploads once the art is final.
# FLAPPY_LOCK_ASSETS=1
