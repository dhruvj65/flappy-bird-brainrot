# Copy this file to .env.local and fill it in. .env.local is gitignored.
#
# The Apps Script web app URL, ending in /exec. Anyone holding this can append
# rows to your Sheet, so treat it as a password.
FLAPPY_SHEET_URL=

# Optional. Must match SHARED_TOKEN at the top of tools/google-apps-script.js.
# Worth setting if the URL has ever been shared or pasted anywhere.
FLAPPY_SHEET_TOKEN=

# Optional: refuse character-artwork uploads once the art is final.
# FLAPPY_LOCK_ASSETS=1
